<mxfile host="app.diagrams.net"><diagram id="licenses" name="FTD License Dependency Map"><mxGraphModel dx="1500" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Cisco Secure Firewall Threat Defense — License Dependency Map" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="35" width="1060" height="50" as="geometry"/></mxCell><mxCell id="ess" value="ESSENTIALS — Perpetual / Required&#xa;Routing • Switching • NAT • HA • Clustering*&#xa;Application &amp; user control • VDB/GeoDB updates&#xa;(*where platform supports it)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="500" height="130" as="geometry"/></mxCell><mxCell id="ips" value="IPS — Term&#xa;Intrusion policies&#xa;Security Intelligence&#xa;File control foundation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="180" y="340" width="300" height="120" as="geometry"/></mxCell><mxCell id="mal" value="MALWARE DEFENSE — Term&#xa;Malware inspection / disposition&#xa;File policy malware actions&#xa;Requires IPS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="600" y="340" width="300" height="120" as="geometry"/></mxCell><mxCell id="url" value="URL FILTERING — Term&#xa;Category + reputation filtering&#xa;DNS request filtering&#xa;Individual URL matching does not require it&#xa;Requires IPS for licensed feature use" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="330" height="140" as="geometry"/></mxCell><mxCell id="client" value="CISCO SECURE CLIENT&#xa;Advantage / Premier / VPN Only&#xa;Remote-access VPN entitlement&#xa;Separate Secure Client licensing model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="360" y="570" width="330" height="130" as="geometry"/></mxCell><mxCell id="carrier" value="CARRIER — Term&#xa;Diameter • GTP/GPRS • SCTP • M3UA inspection&#xa;Only on supported platforms" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="810" y="570" width="330" height="130" as="geometry"/></mxCell><mxCell id="bundles" value="Common ordering shorthand: T = IPS/Threat; TM = IPS + Malware; TC = IPS + URL; TMC = IPS + Malware + URL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="750" width="840" height="60" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ess" target="ips"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="290"/><mxPoint x="330" y="290"/></Array></mxGeometry></mxCell><mxCell id="e2" value="prerequisite" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ips" target="mal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="prerequisite" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ips" target="url"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="510"/><mxPoint x="1185" y="510"/></Array></mxGeometry></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ess" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="530"/><mxPoint x="525" y="530"/></Array></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ess" target="carrier"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="